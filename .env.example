SHARED_ROOT=/mnt/tank/family_share
APP_SECRET=replace-with-a-long-random-value-at-least-32-characters
ADMIN_USERNAME=family
# Generate with: backend/.venv/bin/python backend/scripts/hash_password.py
# Single quotes are important with Docker Compose: do not interpolate $ in Argon2.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME'
SESSION_HOURS=24
COOKIE_SECURE=true
# Exact public origin; used to reject cross-site state-changing requests.
PUBLIC_ORIGIN=https://files.example.com
